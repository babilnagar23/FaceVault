# ─────────────────────────────────────────────────────────
# FaceVault API — Environment Configuration Template
# Copy this to .env and fill in all values.
# NEVER commit .env to source control.
# ─────────────────────────────────────────────────────────

# Application
APP_NAME="FaceVault API"
APP_ENV=development
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO

# API
API_PREFIX=/api/v1
DOCS_ENABLED=true

# ─── Database ────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://facevault:facevault_dev@localhost:5432/facevault
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ─── Redis ───────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── Authentication ──────────────────────────────────────
# Use strong random strings in production: openssl rand -hex 64
JWT_SECRET_KEY=CHANGE_ME_USE_OPENSSL_RAND_HEX_64
JWT_REFRESH_SECRET_KEY=CHANGE_ME_DIFFERENT_FROM_ACCESS_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── CORS ────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Object Storage (MinIO dev / S3 prod) ────────────────
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=facevault-dev
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_PRESIGNED_URL_EXPIRE_SECONDS=3600

# ─── Biometric Thresholds ────────────────────────────────
FACE_MATCH_THRESHOLD=0.85
LIVENESS_THRESHOLD=0.80
MINIMUM_FACE_QUALITY=0.70

# ─── GPS / Geofence ──────────────────────────────────────
DEFAULT_GEOFENCE_RADIUS_METERS=150
GPS_ACCURACY_THRESHOLD_METERS=50
MAX_CLOCK_DRIFT_SECONDS=300

# ─── Attendance ──────────────────────────────────────────
GRACE_PERIOD_MINUTES=15
LATE_THRESHOLD_MINUTES=30
CHECKIN_WINDOW_HOURS=2
MAX_OFFLINE_DAYS=7

# ─── FCM (Firebase Cloud Messaging) ──────────────────────
FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=

# ─── Monitoring ──────────────────────────────────────────
SENTRY_DSN=
